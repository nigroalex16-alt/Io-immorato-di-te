import tkinter as tk
from tkinter import ttk
import webbrowser  # Libreria standard per aprire i link nel browser

# 1. Creazione della finestra principale
root = tk.Tk()
root.title("App Riproduttore Video")
root.geometry("450x350")

# 2. Creazione del contenitore delle tab (Notebook)
notebook = ttk.Notebook(root)

# 3. Creazione dei Frame per ogni singola tab
tab1 = ttk.Frame(notebook)
tab2 = ttk.Frame(notebook)

# Aggiungiamo le tab al notebook con i relativi titoli
notebook.add(tab1, text="Video 1")
notebook.add(tab2, text="Video 2")
notebook.pack(expand=True, fill="both")


# 4. Funzioni per aprire i video musicali/tutorial di esempio
def apri_video_1():
  # Sostituisci questo URL con il link del video che desideri
  url = "https://youtube.com"
  webbrowser.open(url)


def apri_video_2():
  # Sostituisci questo URL con il link del secondo video
  url = "https://youtube.com"
  webbrowser.open(url)


# 5. Creazione e posizionamento dei pulsanti dentro le rispettive tab
btn1 = ttk.Button(tab1, text="▶ Riproduci Primo Video", command=apri_video_1)
btn1.pack(pady=60)

btn2 = ttk.Button(tab2, text="▶ Riproduci Secondo Video", command=apri_video_2)
btn2.pack(pady=60)

# Avvio del programma
root.mainloop()

